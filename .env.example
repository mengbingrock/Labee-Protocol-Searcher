# Copy to `.env` (gitignored) and fill in. Values here fill gaps in the real
# environment — an MCP client's `env` block always takes precedence.

# Identifies you to the Crossref/OpenAlex/NCBI polite pools, and is REQUIRED to
# enable the Unpaywall open-access full-text fallback in `fetch`.
PROTOCOLS_CONTACT_EMAIL=you@example.com

# Optional: a free key makes vendor search rate-limit-free (else keyless DuckDuckGo).
# BRAVE_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CSE_CX=

# Optional: raise journal-provider rate limits (both work without a key).
# SEMANTIC_SCHOLAR_API_KEY=
# NCBI_API_KEY=

# Search refreshes a validated, per-DOI retrieval index generated by the daily
# GitHub health workflow. Set to "off" to use only the committed local snapshot.
# PROTOCOLS_FETCHABILITY_INDEX_URL=https://raw.githubusercontent.com/mengbingrock/Labee-Protocol-Searcher/main/fetchability-index.json
# PROTOCOLS_FETCHABILITY_INDEX_REFRESH_MS=900000
# PROTOCOLS_FETCHABILITY_INDEX_TIMEOUT_MS=2500
# PROTOCOLS_FETCHABILITY_INDEX_PATH=/absolute/path/to/fetchability-index.json
