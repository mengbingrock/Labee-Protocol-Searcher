# Copy to `.env` (gitignored) and fill in. Values here fill gaps in the real
# environment — an MCP client's `env` block always takes precedence.

# ---------------------------------------------------------------------------
# Default stdio mode: forward every MCP request to the remote HTTP backend
# ---------------------------------------------------------------------------
# The URL defaults to the public deployment. Its bearer token is required by
# that deployment. MCP_BEARER_TOKEN and PROTOCOLS_MCP_TOKEN are accepted as
# compatibility aliases when PROTOCOLS_REMOTE_MCP_TOKEN is unset.
# PROTOCOLS_REMOTE_MCP_URL=https://labee.online/mcp
# PROTOCOLS_REMOTE_MCP_TOKEN=
# PROTOCOLS_REMOTE_MCP_TIMEOUT_MS=300000

# The remaining search/fetch settings are consumed by `--http` backends and
# one-shot CLI commands. Default stdio mode does not execute those paths.

# Identifies you to the Crossref/OpenAlex/NCBI polite pools, and is REQUIRED to
# enable the Unpaywall open-access full-text fallback in `fetch`.
PROTOCOLS_CONTACT_EMAIL=you@example.com

# REQUIRED for vendor search — set BRAVE_API_KEY, or both GOOGLE_ values. There
# is no keyless provider; without a key, vendor sources return no results and
# say so (journal search and open-access `fetch` are unaffected).
# BRAVE_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CSE_CX=

# Optional: raise journal-provider rate limits (both work without a key).
# SEMANTIC_SCHOLAR_API_KEY=
# NCBI_API_KEY=

# Network context. Entitlement to publisher content is decided by IP, so Labee
# detects once at startup whether it is calling from an academic network. Force
# the verdict, or switch the lookup off entirely.
# PROTOCOLS_NETWORK_KIND=academic|commercial|unknown
# PROTOCOLS_NETWORK_DETECT=off
# PROTOCOLS_NETWORK_LOOKUP_URL=https://ipinfo.io/json
# PROTOCOLS_NETWORK_TIMEOUT_MS=4000

# On an academic network, `fetch` will try the publisher's own copy of a
# paywalled DOI before falling back to the abstract. That content is NOT open
# access — it is read under your institution's subscription, whose terms govern
# what you may do with it. Set to "off" to never attempt it.
# PROTOCOLS_ENTITLED_FETCH=off

# Some PMC records are free to read but outside the Open Access Subset: the
# publisher granted display rights without a redistribution licence, so the OA
# APIs decline them while Europe PMC still serves a free PDF. Labee retrieves
# those and labels them `display-only-full-text`. Set to "off" to skip them.
# PROTOCOLS_DISPLAY_ONLY_FETCH=off

# Local default-profile recovery is explicit (`browser: default` in MCP tools,
# or `--browser default` in the CLI). On macOS, Labee creates one dedicated
# window in the user's normal Google Chrome profile and addresses only that
# window. Chrome must enable View > Developer > Allow JavaScript from Apple
# Events. Existing windows and tabs are never inspected or closed.
# PROTOCOLS_BROWSER_INTERACTION_TIMEOUT_MS=20000

# External-CDP mode (`browser: cdp`) remains available for operators who already
# manage their own loopback CDP browser.
# PROTOCOLS_BROWSER_CDP_URL=http://127.0.0.1:9222

# Primary publisher search and publisher-page retrieval. It uses no browser on
# this machine and opens no visible Chrome window. Scholarly/web databases and
# ordinary HTTP are fallbacks when the publisher route fails. It is never used
# for entitled retrieval, whose premise is the calling network's own IP.
# Browser-derived results are labelled `display-only-full-text`, never `ok`.
# BROWSERLESS_TOKEN=
# BROWSERLESS_URL=https://production-sfo.browserless.io
# BROWSERLESS_TIMEOUT_MS=30000
# PROTOCOLS_BROWSERLESS=off

# ---------------------------------------------------------------------------
# Residential exit (opt-in): lend this machine's connection to the remote browser
# ---------------------------------------------------------------------------
# The browserless fallback above calls from the server's datacenter, which is
# why it is barred from entitled retrieval and why vendor sites are hostile to
# it. Enabling this makes the stdio bridge on THIS PC register itself with a
# self-hosted browserless server as a residential exit. It forwards every MCP
# request to the remote backend and advertises the connected exit only on
# search/fetch calls; the remote backend consumes it only for configured
# publisher retries. The agent token is never included in an MCP request.
#
# Requirements and caveats:
#   - Only a self-hosted browserless with RESIDENTIAL_PROXY_ENABLED=true offers
#     this. The hosted browserless.io service does not, so BROWSERLESS_URL (or
#     RESIDENTIAL_PROXY_URL) must point at your own server.
#   - Residential calls use /content; /unblock is hosted-only and 404s there.
#   - stdio mode and one-shot `--query`/`--fetch` register. `--http` never does:
#     that process is the hosted server itself.
#   - The first render waits up to RESIDENTIAL_PROXY_READY_TIMEOUT_MS for the
#     registration to complete, so it doesn't slip out from the datacenter.
#   - Hosts not on the allowlist are rendered from the datacenter rather than
#     refused: the open-access tiers hand this fallback arbitrary publisher URLs.
#   - Consent is separate from enabling, on purpose: this lends out a network
#     connection, and other people's traffic will exit from your IP.
#   - Traffic is limited to ports 80/443 and public addresses; the tunnel is
#     encrypted end-to-end with keys derived from the shared token, so whatever
#     terminates TLS in front of the server cannot read it.
#
# PROTOCOLS_RESIDENTIAL_PROXY=on
# RESIDENTIAL_PROXY_CONSENT=true
# RESIDENTIAL_PROXY_AGENT_TOKEN=          # must match the server's token
# RESIDENTIAL_PROXY_URL=                  # defaults to BROWSERLESS_URL
# RESIDENTIAL_PROXY_COUNTRY=US            # two-letter ISO code, self-declared
# RESIDENTIAL_PROXY_REGION=CA
# RESIDENTIAL_PROXY_CITY=Los Angeles
# RESIDENTIAL_PROXY_MAX_CONNECTIONS=8
# RESIDENTIAL_PROXY_ALLOW_HOSTS=          # default: every catalog source as *.host
#   Not `*` by default: a headless browser opens several background
#   connections per render (Google update/telemetry), and with `*` each one
#   takes a slot on this agent — measured to starve the real target at low
#   connection limits. Set `*` explicitly to lend the exit for any host.
# RESIDENTIAL_PROXY_READY_TIMEOUT_MS=4000
# RESIDENTIAL_PROXY_AGENT_ID=             # defaults to hostname + random suffix
# RESIDENTIAL_PROXY_CONTROL_PROXY=        # e.g. socks5://127.0.0.1:1080
